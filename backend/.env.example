# SQLite locally. For Supabase use the Postgres connection string from
# Project Settings -> Database, e.g.
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./conceptdebt.db

# Optional AI layer (any OpenAI-compatible API; defaults to Featherless).
# Without a key the app runs fully on rule-based diagnosis and templates.
AI_API_KEY=
AI_BASE_URL=https://api.featherless.ai/v1
AI_MODEL=Qwen/Qwen2.5-32B-Instruct
# Set to 1 to switch the AI off without removing the key
AI_DISABLED=0

# Comma-separated origins allowed to call the API ("*" for the hackathon)
CORS_ORIGINS=*
