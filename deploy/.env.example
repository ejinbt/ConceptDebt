# Port the API listens on, on 127.0.0.1 only (change it if 8000 is taken)
API_PORT=8000

# Only when using the bundled Caddy (nothing else on ports 80/443):
# COMPOSE_PROFILES=caddy
# DOMAIN=api.94.249.197.142.sslip.io

# Already running a reverse proxy in Docker (shared Caddy/Traefik)? Join its network:
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# PROXY_NETWORK=caddy_default
